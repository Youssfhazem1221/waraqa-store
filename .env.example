# ============================================================
# Waraqa Store — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your values.
# .env.local is gitignored; this template is not.
# ============================================================

# Google Apps Script Web App URL (the /exec endpoint).
# Get it by deploying waraqa-apps-script.gs as a Web App
# (Execute as: Me, Who has access: Anyone).
NEXT_PUBLIC_WEB_APP_URL=

# Owner's WhatsApp number, international format, used only for the footer
# contact link. Egypt +20, drop the leading 0: 01069237525 -> 201069237525
NEXT_PUBLIC_WHATSAPP_NUMBER=201069237525

# ---- Delivery fees (EGP) ----
# Two zones. Cairo + Giza pay the first, every other governorate the second.
# Keep these in sync with SHIPPING_CAIRO / SHIPPING_OUTSIDE in
# waraqa-apps-script.gs — the storefront quotes the fee, the backend charges it.
NEXT_PUBLIC_SHIPPING_CAIRO=60
NEXT_PUBLIC_SHIPPING_OUTSIDE=75

# Free delivery threshold — applies to the Cairo zone ONLY.
NEXT_PUBLIC_FREE_SHIP_OVER=800

NEXT_PUBLIC_CURRENCY=EGP

# ---- PostHog analytics (optional) ----
# Leave the key blank to disable analytics entirely.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ---- Canonical origin ----
# Used for metadataBase, canonical URLs, sitemap and robots.
# No trailing slash. Env changes need a dev-server restart.
NEXT_PUBLIC_SITE_URL=https://waraqa.art

# ---- Search engine ownership (optional) ----
# Only needed for the HTML-tag method. Verifying the waraqa.art *domain*
# property by DNS (Search Console offers it; Cloudflare adds the TXT record)
# covers every host and scheme and needs neither of these.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# ---- Admin token ----
# Deliberately NOT here, and not in waraqa-apps-script.gs either (this repo is
# public). It lives in the Apps Script project's Script Properties as
# ADMIN_TOKEN and is typed into the CRM at runtime.
#
# Never give a secret a NEXT_PUBLIC_ prefix: Next copies those into the
# JavaScript every visitor downloads.
